# ==============================================================================
# Enterprise Multi-Agent MCP Router - Environment Configuration
# ==============================================================================

# Server Settings
HOST=0.0.0.0
PORT=8000
APP_ENV=production
LOG_LEVEL=INFO

# LLM & Routing Settings (Optional: If omitted, high-speed deterministic semantic router is used)
OPENAI_API_KEY=
ROUTER_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# MCP & Tool Execution Resilience
MCP_TIMEOUT_SECONDS=10.0
MAX_TOOL_RETRIES=2
CIRCUIT_BREAKER_THRESHOLD=3

# Metrics & Telemetry
ENABLE_METRICS=true
